# The mobile PWA build, and the data files it is built from. All generated:
# `npm run mobile:data` rebuilds the index, the country pack and the icons from a
# harvested catalog. The index alone is megabytes and changes with every harvest,
# which is not something a git history is improved by.
dist-mobile/
src/mobile/public/index.json
src/mobile/public/index.json.gz
src/mobile/public/world.json.gz
src/mobile/public/icon*.png
src/mobile/public/icon.svg

# Generated by `npm run twa:assetlinks`. Not committed because it is derived, and because
# the fingerprint that belongs in it depends on how the app was signed -- Play App Signing
# replaces your upload key with Google's, so the value differs between a sideloaded build
# and a published one.
src/mobile/public/.well-known/

# The Android TWA wrapper. Only the manifest is source; `bubblewrap update` regenerates
# the whole Gradle project from it, so committing the generated tree would be committing a
# build output that goes stale the moment the manifest changes.
#
# android.keystore and the .keystore.json holding its passwords must NEVER be committed.
# Losing that key means no existing install can ever be updated; publishing it means anyone
# can ship an update to your users.
android/*
!android/twa-manifest.json
*.keystore
*.jks
*.keystore.json

# Wrangler's local state and Cloudflare credentials.
.wrangler/

# Local data: the harvested catalog, geometry cache and downloaded bulk files.
# These are rebuildable from the source registry and can reach hundreds of MB.
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
