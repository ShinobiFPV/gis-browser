{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/main/**/*",
    "src/harvester/**/*",
    "src/db/**/*",
    "src/resolve/**/*",
    "src/export/**/*",
    "src/shared/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node", "electron-vite/node"],
    "noEmit": true
  }
}
